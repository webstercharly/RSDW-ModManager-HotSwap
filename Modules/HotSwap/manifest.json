{
  "schemaVersion": 1,
  "id": "hot-swap",
  "name": "Hot Swap",
  "description": "Colour-coded combat equipment swaps and configurable hotkeys.",
  "version": "0.1.3-dev",
  "order": 20,
  "entry": "module.lua",
  "ui": {
    "menuLabel": "HOT SWAP",
    "actions": [
      {
        "id": "toggle",
        "label": "APPLY SWAP",
        "primary": true,
        "inputHint": "Swap number (1–99), or a shortcut for Set Key",
        "requiresInput": true
      },
      {
        "id": "edit",
        "label": "EDIT GEAR",
        "requiresInput": true
      },
      {
        "id": "capture",
        "label": "CAPTURE CURRENT",
        "inputHint": "Swap number (example: 1)",
        "requiresInput": true
      },
      {
        "id": "set-hotkey",
        "label": "SET KEY",
        "inputHint": "Select a swap or enter its number, then press Set Key",
        "requiresInput": true
      },
      {
        "id": "set-slot",
        "label": "USE EQUIPPED",
        "requiresInput": false
      },
      {
        "id": "open-backpack",
        "label": "CHOOSE FROM BACKPACK"
      },
      {
        "id": "save-backpack-item",
        "label": "SAVE TO SLOT",
        "primary": true
      },
      {
        "id": "remove-slot",
        "label": "REMOVE SLOT",
        "requiresInput": false
      },
      {
        "id": "clear",
        "label": "CLEAR SWAP",
        "inputHint": "Swap number (example: 1)",
        "requiresInput": true,
        "destructive": true
      }
    ]
  }
